# Configuración de despliegue FTP a producción para Andamios Ligeros
# Copia este archivo con el nombre .deploy.env y completa con tus credenciales reales:
#   cp .deploy.env.example .deploy.env

FTP_HOST=ftp.andamiosligeros.com
FTP_USER=usuario_cpanel
FTP_PASS=tu_contraseña
FTP_PORT=21
FTP_SSL=false

# Rutas remotas en el servidor cPanel
# REMOTE_CORE_DIR: carpeta donde reside el backend de Laravel (fuera de public_html)
REMOTE_CORE_DIR=app_andamios
# REMOTE_PUBLIC_DIR: carpeta pública del servidor web
REMOTE_PUBLIC_DIR=public_html/andamiosligeros_public
